<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Row 1: Card Name & Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCreditCardName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Card Name"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCreditCardStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paid"
            android:textColor="@color/green_mint"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Row 2: Billed Amount & Unbilled Spends Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Billed Amount -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BILLED AMOUNT"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvCreditCardBilledAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹0"
                android:textColor="@color/amber_gold"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Unbilled Amount -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNBILLED SPENDS"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvCreditCardUnbilledAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹0"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Due Date & Last Paid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCreditCardDueDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Due: 15/11/2026"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvCreditCardLastPaid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Paid: N/A"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Row 4: Tagged Transactions and Add Tx Buttons (No horizontal scroll) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnViewCardTransactions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="📜 Tagged Transactions"
            android:textColor="@color/blue_sky"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_chip_blue"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnAddCardTransaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="＋ Add Tx"
            android:textColor="@color/green_mint"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_chip_green"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Row 5: Action Buttons (Bill Generated, Mark as Paid, Update Due/Bill) (No horizontal scroll) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Mark as Bill Generated Button -->
        <TextView
            android:id="@+id/btnMarkBillGenerated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="⚡ Bill Generated"
            android:textColor="@color/blue_sky"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_chip_blue"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Quick Mark as Paid Button (Visible only when Billed > 0) -->
        <TextView
            android:id="@+id/btnMarkCreditCardPaidQuick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="✓ Mark as Paid"
            android:textColor="@color/green_mint"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_chip_green"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Update Due / Bill Button -->
        <TextView
            android:id="@+id/btnEditCreditCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 Update Bill"
            android:textColor="@color/text_primary"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_pill_dark"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
