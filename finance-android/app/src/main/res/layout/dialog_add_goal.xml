<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Financial Goal"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Enter goal details. You can track manually or link to accounts / mutual funds."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Field 1: Goal Name (Mandatory & Unique) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Goal Name *"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGoalName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="e.g. Vacation Fund, Car, Emergency Fund"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:inputType="textCapWords"
            android:imeOptions="actionNext"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Field 2: Target Goal Amount (Mandatory) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Target Goal Amount (₹) *"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGoalTargetAmount"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="e.g. 200000.00"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:imeOptions="actionNext"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Field 3: Initial Saved Amount (Optional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Initial Saved Amount (₹) [Optional]"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGoalCurrentAmount"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="0.00"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Field 4: Asset Contribution Linker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Asset Contribution Linker"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGoalLinkType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbLinkNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manual Tracking (No auto-linked asset)"
                android:checked="true"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <RadioButton
                android:id="@+id/rbLinkAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Link Bank Account Balance"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <RadioButton
                android:id="@+id/rbLinkMutualFund"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Link Mutual Fund Category Valuation"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />
        </RadioGroup>

        <!-- Container: Link Bank Account -->
        <LinearLayout
            android:id="@+id/layoutLinkAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_pill_dark"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Bank Account"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spGoalAccount"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_spinner_dark"
                android:popupBackground="@color/bg_card_secondary"
                android:dropDownVerticalOffset="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Allocation Percentage (%)"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGoalAccountPercent"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card"
                android:hint="100"
                android:text="100"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="numberDecimal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Container: Link Mutual Fund -->
        <LinearLayout
            android:id="@+id/layoutLinkMutualFund"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_pill_dark"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Mutual Fund Sub-Category / Type"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spGoalMfType"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_spinner_dark"
                android:popupBackground="@color/bg_card_secondary"
                android:dropDownVerticalOffset="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Allocation Percentage (%)"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGoalMfPercent"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card"
                android:hint="100"
                android:text="100"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="numberDecimal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelGoal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/bg_card_secondary"
                app:strokeColor="@color/border_dark"
                app:strokeWidth="1dp"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitGoal"
                android:layout_width="0dp"
                android:layout_weight="1.4"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/colorPrimary"
                android:text="＋ Add Goal"
                android:textColor="@color/text_on_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
