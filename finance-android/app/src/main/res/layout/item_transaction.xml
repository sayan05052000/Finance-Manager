<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Row 1: Source Badge / Date / Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Account / Loan Badge -->
        <TextView
            android:id="@+id/tvTxSourceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SLICE CREDIT"
            android:textColor="@color/amber_gold"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_loan"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <TextView
            android:id="@+id/tvTxDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="06/11/2026"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Debit / Credit Amount -->
        <TextView
            android:id="@+id/tvTxAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-₹1,000.00"
            android:textColor="@color/red_rose"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: SubCategory & Running Remainder -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTxCategoryDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mutual Fund • Savings"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTxRemainder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹30,209.72"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnDeleteTxItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_dark"
            android:text="🗑️ Delete"
            android:textColor="@color/red_rose"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

</LinearLayout>
