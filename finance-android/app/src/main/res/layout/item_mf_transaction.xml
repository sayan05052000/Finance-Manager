<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Top Row: Date, Type Badge, and Folio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMfTxDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07/11/2026"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvMfTxFolio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Folio: 8864254"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvMfTxTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Buy / SIP"
            android:textColor="@color/green_mint"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scheme Name -->
    <TextView
        android:id="@+id/tvMfTxSchemeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="BANDHAN SMALL CAP FUND"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Meta: Category • SubCategory • Platform -->
    <TextView
        android:id="@+id/tvMfTxMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Equity • Small Cap • Groww"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Metrics Row: Amount, Units, NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Amount -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMOUNT"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvMfTxAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹5,000.00"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Units -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNITS"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvMfTxUnits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="89.605"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- NAV -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAV"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvMfTxNav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹55.602"
                android:textColor="@color/green_mint"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>