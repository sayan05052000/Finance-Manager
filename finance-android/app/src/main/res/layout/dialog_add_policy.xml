<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Add Insurance Policy"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Enter policy details to append to LIC AND TATA AIA sheet"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Policy Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Policy Number *"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddPolicyNumber"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="e.g. 438739536 or C202635066"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Sub-Category Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Sub-Category / Provider *"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnSelectPolicySubCategory"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvAddPolicySubCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LIC Policies"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Premium Amount -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Annual Premium (₹) *"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddPolicyAmount"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="e.g. 5230"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Sum Assured -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Sum Assured (₹)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddPolicySumAssured"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="e.g. 500000"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Due Date with Calendar Picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Due Date (Calendar Picker) *"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddPolicyDueDate"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="dd/MM/yyyy"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="8dp"
        android:drawableTint="@color/green_mint"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Last Paid Date with Calendar Picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Last Paid Date (Calendar Picker)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddPolicyLastPaid"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="dd/MM/yyyy"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="8dp"
        android:drawableTint="@color/green_mint"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />



        <!-- Notes / Remarks -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Notes / Status (Optional)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddPolicyNotes"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="e.g. Active, Surrender pending, etc."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPolicySubmit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:text="Add Policy to Google Sheet"
            android:textColor="#0B0F19"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/green_emerald"
            app:cornerRadius="25dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
