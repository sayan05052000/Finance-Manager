<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_dark" />

        <!-- Header Row: Title & Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGoalContribTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Goal Contribution"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGoalContribSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Target: ₹2,00,000.00"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseContribSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_dark"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Hero KPI Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Accumulated Balance"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvGoalContribAccumulated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹41,407.97"
                        android:textColor="@color/green_mint"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGoalContribPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_good"
                    android:text="20.7% Achieved"
                    android:textColor="@color/green_mint"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />
            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/pbGoalContribProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="20"
                android:progressTint="@color/green_mint"
                android:progressBackgroundTint="@color/border_dark" />

            <!-- Remaining to target text -->
            <TextView
                android:id="@+id/tvGoalContribRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="₹1,58,592.03 remaining to reach target"
                android:textColor="@color/amber_gold"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Contributing Asset Sources"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Calculated in real-time from your linked accounts and holdings"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Dynamic Container for Contribution Sources -->
        <LinearLayout
            android:id="@+id/layoutContributingAssets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditGoalFromContrib"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/bg_card_secondary"
                app:strokeColor="@color/border_dark"
                app:strokeWidth="1dp"
                android:text="✏️ Edit Goal"
                android:textColor="@color/blue_sky"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseGoalContrib"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/colorPrimary"
                android:text="Done"
                android:textColor="@color/text_on_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
