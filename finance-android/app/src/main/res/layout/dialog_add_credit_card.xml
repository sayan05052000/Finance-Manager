<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_dark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💳 Add Credit Card"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Enter card name (mandatory &amp; unique). Due date and billed amount are optional."
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- Field 1: Card Name (Mandatory & Unique) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Card Name (Mandatory &amp; Unique) *"
        android:textColor="@color/amber_gold"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etAddCardName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="e.g. Tata Neu Infinity, HDFC Swyp, SBI SimplyCLICK"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:inputType="textCapWords"
        android:imeOptions="actionNext"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Field 2: Due Date (Optional) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Due Date (Optional)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAddCardDueDate"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="Select or enter DD/MM/YYYY (Optional)"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:inputType="date"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Field 3: Billed Amount (Optional) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Statement Billed Amount (₹) (Optional)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAddCardBilledAmount"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="0.00 (Optional)"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAddCardCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_dark"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAddCardSubmit"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_emerald"
            android:text="+ Add Card"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
