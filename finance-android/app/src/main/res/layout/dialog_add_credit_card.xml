<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_dark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Credit Card"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Enter card name (mandatory &amp; unique). Due date and billed amount are optional."
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- Field 1: Card Name (Mandatory & Unique) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Card Name *"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etAddCardName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="e.g. Tata Neu Infinity, HDFC Swyp, SBI SimplyCLICK"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:inputType="textCapWords"
        android:imeOptions="actionNext"
        android:textSize="14sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Field 2: Due Date (Optional) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Due Date (Calendar Picker)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etAddCardDueDate"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="Select DD/MM/YYYY (Optional)"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:focusable="false"
        android:clickable="true"
        android:cursorVisible="false"
        android:drawableEnd="@drawable/ic_calendar"
        android:drawablePadding="8dp"
        android:drawableTint="@color/colorPrimary"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Field 3: Billed Amount (Optional) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Statement Billed Amount (₹) (Optional)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etAddCardBilledAmount"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="0.00 (Optional)"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:textSize="14sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCardCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/bg_card_secondary"
            app:strokeColor="@color/border_dark"
            app:strokeWidth="1dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCardSubmit"
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/colorPrimary"
            android:text="+ Add Card"
            android:textColor="@color/bg_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
