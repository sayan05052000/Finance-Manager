<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <!-- Header Drag Pill Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pill_dark" />

    <!-- Header Row: Title & Subtitle & Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAccountSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Transactions"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAccountSheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Live Balance • Inflows &amp; Outflows"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseAccountSheet"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"
            android:contentDescription="Close"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Metrics Summary Bar: Entries / Inflow / Outflow / Open in Ledger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_dark"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSheetTxCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 txns"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSheetTotalInflow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+₹0"
            android:textColor="@color/green_mint"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSheetTotalOutflow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-₹0"
            android:textColor="@color/red_rose"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnOpenInLedger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Ledger ↗"
            android:textColor="@color/blue_sky"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Quick Action: + Add Transaction for this Entity -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetAddTransaction"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        app:cornerRadius="22dp"
        app:backgroundTint="@color/colorPrimary"
        android:text="＋ Add Transaction for this Account"
        android:textColor="@color/text_on_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

    <!-- Transactions List Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAccountTransactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvEmptyAccountTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No transactions recorded for this item."
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
