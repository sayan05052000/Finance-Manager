<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_dark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✏️ Update Credit Card"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Update current billed amount and due date. (Payment cannot be recorded from this dialog)"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- Card Summary Chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEditCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Card Name"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEditCardUnbilledSpends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Unbilled Spends: ₹0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Field 1: Billed Amount -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Statement Billed Amount (₹)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etEditBilledAmount"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="e.g. 5000.00"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Field 2: Due Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Due Date (DD/MM/YYYY)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etEditDueDate"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="Select or enter DD/MM/YYYY"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:inputType="date"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Explicit Constraint Note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ℹ️ Note: This update modal does not allow marking the card as paid. Use the 'Mark as Paid' action to clear the bill."
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditCardCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_dark"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnEditCardSubmit"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_emerald"
            android:text="Save Changes"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
