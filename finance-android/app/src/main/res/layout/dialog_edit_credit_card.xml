<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_dark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Credit Card"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Update current billed amount and due date"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- Card Summary Hero Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_dark"
        android:padding="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEditCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Card Name"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEditCardUnbilledSpends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Unbilled Spends: ₹0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Field 1: Billed Amount -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Statement Billed Amount (₹)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditBilledAmount"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="e.g. 5000.00"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:textSize="14sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Field 2: Due Date with Calendar Picker -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Due Date (Calendar Picker)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditDueDate"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_dark"
        android:hint="Select DD/MM/YYYY"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:focusable="false"
        android:clickable="true"
        android:cursorVisible="false"
        android:drawableEnd="@drawable/ic_calendar"
        android:drawablePadding="8dp"
        android:drawableTint="@color/colorPrimary"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <!-- Explicit Constraint Note in Rounded Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_dark"
        android:padding="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: This update modal does not mark the card as paid. Use the 'Mark as Paid' action on the card to clear the bill."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Footer Action Buttons: Cancel and Save Changes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditCardCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/bg_card_secondary"
            app:strokeColor="@color/border_dark"
            app:strokeWidth="1dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditCardSubmit"
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/colorPrimary"
            android:text="Save Changes"
            android:textColor="@color/bg_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
