<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <!-- Row 1: Fund Name & Role Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSipFundName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bandhan Small Cap"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSipRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aggressor"
            android:textColor="@color/amber_gold"
            android:textSize="10sp"
            android:background="@drawable/bg_pill_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/btnEditSip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="✏️ Edit"
            android:textColor="@color/blue_royal"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnDeleteSipItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="🗑️ Delete"
            android:textColor="@color/red_rose"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Row 2: Account and Platform -->
    <TextView
        android:id="@+id/tvSipAccountPlatform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Slice • upiauto"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Row 3: Current Month & Next Month SIP Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Current Month Status Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tvSipCurrentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nov SIP: ₹3,170"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Interactive Status Button/Pill -->
            <TextView
                android:id="@+id/btnSipCurrentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Not Paid"
                android:textColor="@color/red_rose"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Next Month Status Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/tvSipNextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dec SIP: ₹3,170"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Interactive Status Button/Pill -->
            <TextView
                android:id="@+id/btnSipNextStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Not Paid"
                android:textColor="@color/red_rose"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
