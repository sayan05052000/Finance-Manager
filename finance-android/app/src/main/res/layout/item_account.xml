<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- Row 1: Account Name and Balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAccountName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PNB"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAccountBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹767.29"
            android:textColor="@color/green_mint"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Transactions and Add Transaction -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAccountTxCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 txs"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnViewAccountTransactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="📜 Transactions"
            android:textColor="@color/blue_sky"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_blue"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnAddAccountTransaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="＋ Add Tx"
            android:textColor="@color/green_mint"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
