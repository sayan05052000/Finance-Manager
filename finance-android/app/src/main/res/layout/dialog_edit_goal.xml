<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Financial Goal"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Modify target amount, saved funds, or asset allocation"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Field 1: Goal Name (Mandatory) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Goal Name *"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGoalName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="e.g. Vacation Fund, Car, Emergency Fund"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:inputType="textCapWords"
            android:imeOptions="actionNext"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Field 2: Target Goal Amount (Mandatory) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Target Goal Amount (₹) *"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGoalTargetAmount"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="e.g. 200000.00"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:imeOptions="actionNext"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Field 3: Initial Saved Amount (Optional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Initial Saved Amount (₹) [Optional]"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGoalCurrentAmount"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="0.00"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Field 4: Asset Contribution Linker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Asset Contribution Linker"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGoalLinkType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbLinkNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manual Tracking (No auto-linked asset)"
                android:checked="true"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <RadioButton
                android:id="@+id/rbLinkAssets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Link Assets (Multiple Accounts &amp; Holdings)"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />
        </RadioGroup>

        <!-- Container for Linked Assets: Multiple Bank Accounts & Multiple Holdings -->
        <LinearLayout
            android:id="@+id/layoutLinkedAssetsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Sub-Section 1: Bank Accounts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏦 Linked Bank Accounts"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddAccountRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ Add Account"
                    android:textColor="@color/green_mint"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_green"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAccountsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyAccounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No bank accounts linked. Tap '＋ Add Account' to link one."
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <!-- Sub-Section 2: Mutual Funds & Holdings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📈 Linked Mutual Funds / Holdings"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddMfRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ Add Holding"
                    android:textColor="@color/green_mint"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_green"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutMfContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyMf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No mutual fund holdings linked. Tap '＋ Add Holding' to link one."
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelGoal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/bg_card_secondary"
                app:strokeColor="@color/border_dark"
                app:strokeWidth="1dp"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitGoal"
                android:layout_width="0dp"
                android:layout_weight="1.4"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/colorPrimary"
                android:text="💾 Save Changes"
                android:textColor="@color/text_on_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
