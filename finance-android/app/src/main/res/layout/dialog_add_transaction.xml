<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollAddTransaction"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutAddTxRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_pill_dark"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Transaction"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Appends directly to your Google Sheet Transactions tab"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- 1. Type Selector (Expense, Income, Do not Consider) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Transaction Type"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbExpense"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Expense"
                android:checked="true"
                android:textColor="@color/red_rose"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbIncome"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Income"
                android:textColor="@color/green_mint"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbDoNotConsider"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="wrap_content"
                android:text="Do not Consider"
                android:textColor="@color/blue_sky"
                android:textSize="12sp" />
        </RadioGroup>

        <!-- 2. Debit Input Field (Visible for Expense & Do not Consider) -->
        <LinearLayout
            android:id="@+id/layoutDebitField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDebitLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Debit (₹) [Can be negative or positive]"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDebit"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_dark"
                android:hint="Exact value, e.g. 1000.00"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:inputType="numberDecimal|numberSigned"
            android:imeOptions="actionDone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- 3. Credit Input Field (Visible for Income & Do not Consider) -->
        <LinearLayout
            android:id="@+id/layoutCreditField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCreditLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Credit (₹) [Goes into 'Credit']"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCredit"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_dark"
                android:hint="Exact value, e.g. 500.00"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:inputType="numberDecimal|numberSigned"
            android:imeOptions="actionDone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- 4. Sub-Category Field with Instant Search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Sub-Category (From Category Tables)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSearchSubCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Search"
                android:textColor="@color/green_mint"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <AutoCompleteTextView
                android:id="@+id/actvSubCategory"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_spinner_dark"
                android:hint="Type or tap to search..."
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:paddingStart="14dp"
                android:paddingEnd="42dp"
                android:completionThreshold="1"
                android:dropDownVerticalOffset="4dp"
                android:popupBackground="@color/bg_card_secondary" />

            <ImageView
                android:id="@+id/btnSubCategoryDropdown"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_down"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <!-- 5. Tag: Choose Account OR Loan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tag Transaction to (Choose Account or Loan):"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgTagType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbTagLoan"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Loan / Card"
                android:checked="true"
                android:textColor="@color/amber_gold"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbTagAccount"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Bank Account"
                android:textColor="@color/green_mint"
                android:textSize="12sp" />
        </RadioGroup>

        <Spinner
            android:id="@+id/spSourceSelector"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_spinner_dark"
            android:popupBackground="@color/bg_card_secondary"
            android:dropDownVerticalOffset="4dp" />

        <!-- 5b. Tag to specific Credit Card (Visible when CREDIT CARD loan is selected) -->
        <LinearLayout
            android:id="@+id/layoutCreditCardTagSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tag to Credit Card:"
                    android:textColor="@color/amber_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddCreditCardInline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ Add Card"
                    android:textColor="@color/green_mint"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_green"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spCreditCardSelector"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_spinner_dark"
                android:popupBackground="@color/bg_card_secondary"
                android:dropDownVerticalOffset="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Unbilled amount of this card will be updated by transaction amount"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 6. Date Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Date (DD/MM/YYYY)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill_dark"
            android:hint="06/11/2026"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="8dp"
            android:drawableTint="@color/green_mint"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />



        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitTransaction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/colorPrimary"
            android:text="Add to Google Sheet"
            android:textColor="@color/bg_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
