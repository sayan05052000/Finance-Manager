<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Sub-Category"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Type below to search or filter sub-categories"
        android:textColor="@color/green_mint"
        android:textSize="12sp" />

    <!-- Search Input Field -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/etSearchSubCategoryQuery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pill_dark"
            android:hint="🔍 Search (e.g. Card, Interest, Fee)..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:paddingStart="14dp"
            android:paddingEnd="42dp" />

        <ImageView
            android:id="@+id/btnClearSearchSubCategory"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:id="@+id/scrollSubCategories"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/layoutSubCategoryItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubCategoryDialogCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        app:cornerRadius="22dp"
        app:backgroundTint="@color/bg_card_secondary"
        app:strokeColor="@color/border_dark"
        app:strokeWidth="1dp"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="false" />
</LinearLayout>